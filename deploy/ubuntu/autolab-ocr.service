[Unit]
Description=Auto Laboratory PaddleOCR VIN service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/autolab/backend
Environment=HOME=/opt/autolab/paddleocr-home
Environment=OCR_HOST=127.0.0.1
Environment=OCR_PORT=8765
Environment=PADDLEOCR_LANG=en
ExecStart=/opt/autolab/paddleocr-venv/bin/python /opt/autolab/backend/ocr_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
