[Unit]
Description=Auto Laboratory durable postprocessing worker
After=network.target autolab-backend.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/autolab/backend
EnvironmentFile=/opt/autolab/backend/.env
ExecStart=/opt/autolab/backend/.venv/bin/python manage.py run_postprocessing_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
