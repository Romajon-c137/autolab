[Unit]
Description=Auto Laboratory Django backend
After=network.target autolab-ocr.service
Wants=autolab-ocr.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/autolab/backend
EnvironmentFile=/opt/autolab/backend/.env
ExecStart=/opt/autolab/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
