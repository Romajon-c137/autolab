DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_ALLOWED_HOSTS=auto.example.com,SERVER_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://auto.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://auto.example.com
DJANGO_TIME_ZONE=Asia/Bishkek

# SQLite is acceptable for a small private start. For production with several
# users, prefer PostgreSQL:
# DATABASE_URL=postgresql://autolab:strong-password@127.0.0.1:5432/autolab
DATABASE_URL=sqlite:////opt/autolab/backend/db.sqlite3

DJANGO_STATIC_ROOT=/opt/autolab/backend/staticfiles
DJANGO_MEDIA_ROOT=/opt/autolab/backend/uploads

# Set True only after HTTPS is configured.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
